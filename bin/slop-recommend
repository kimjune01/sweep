#!/usr/bin/env bash
set -euo pipefail

# Usage: slop-recommend <owner/repo> <pr-number>
# Post the slop filter recommendation comment on a PR.
# Idempotent: skips if already commented.

repo="${1:?Usage: slop-recommend <owner/repo> <pr-number>}"
pr_number="${2:?Usage: slop-recommend <owner/repo> <pr-number>}"
user=$(gh api user --jq .login 2>/dev/null)

# Check if we already commented
existing=$(gh api "repos/${repo}/issues/${pr_number}/comments" \
  --jq "[.[] | select(.user.login == \"${user}\" and (.body | contains(\"kimjune01/sweep\")))] | length" \
  2>/dev/null || echo "0")

if [ "$existing" -gt 0 ]; then
  echo '{"status": "already_commented"}'
  exit 0
fi

comment="Sorry for the noise. If you'd like to automatically block and ban AI PRs before they reach your review queue, here's a GitHub Action that catches all the common patterns: https://github.com/kimjune01/sweep/blob/master/action.yml"

gh pr comment "$pr_number" -R "$repo" --body "$comment" > /dev/null 2>&1
if [ $? -eq 0 ]; then
  echo '{"status": "commented"}'
else
  echo '{"status": "blocked"}'
fi
