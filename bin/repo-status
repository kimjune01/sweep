#!/usr/bin/env bash
set -euo pipefail

# Usage: repo-status <owner/repo>
# Single source of truth for whether a repo is available for pipeline work.
# Returns JSON: {verdict: "clear"|"cooldown"|"evicted"|"banned", reason: "..."}
#
# Checks (in order, first match wins):
#   1. DENYLIST.md — permanent ban
#   2. retro.jsonl permanent_eviction
#   3. retro.jsonl cooldown_until (not yet expired)
#   4. Drip queue rejection cooldown (closure within 7 days)
#   5. All clear

repo="${1:?Usage: repo-status <owner/repo>}"
owner_repo=$(echo "$repo" | tr '/' '-')
sweep="$HOME/.sweep"
now=$(date +%s)

# 1. Denylist
if [ -f "$sweep/DENYLIST.md" ] && grep -q "$repo" "$sweep/DENYLIST.md"; then
  reason=$(grep "$repo" "$sweep/DENYLIST.md" | head -1 | sed 's/^- //')
  jq -n --arg v "banned" --arg r "$reason" '{verdict: $v, reason: $r}'
  exit 0
fi

# 2. Permanent eviction in retro params
retro="$sweep/repos/${owner_repo}/retro.jsonl"
if [ -f "$retro" ]; then
  # Read the latest status entry
  latest_status=$(tail -r "$retro" | while IFS= read -r line; do
    key=$(echo "$line" | jq -r '.key // empty')
    if [ "$key" = "status" ]; then
      echo "$line"
      break
    fi
  done)

  if [ -n "$latest_status" ]; then
    val=$(echo "$latest_status" | jq -r '.value // empty')
    reason=$(echo "$latest_status" | jq -r '.reason // empty')
    case "$val" in
      permanent_eviction)
        jq -n --arg v "evicted" --arg r "$reason" '{verdict: $v, reason: $r}'
        exit 0
        ;;
      evicted)
        jq -n --arg v "evicted" --arg r "$reason" '{verdict: $v, reason: $r}'
        exit 0
        ;;
      cooldown_*)
        # Extract date from reason (looks for YYYY-MM-DD pattern)
        cooldown_date=$(echo "$reason" | grep -oE '20[0-9]{2}-[0-9]{2}-[0-9]{2}' | tail -1)
        if [ -n "$cooldown_date" ]; then
          cooldown_epoch=$(date -j -f "%Y-%m-%d" "$cooldown_date" +%s 2>/dev/null || echo 0)
          if [ "$cooldown_epoch" -gt "$now" ]; then
            jq -n --arg v "cooldown" --arg r "Cooldown active until $cooldown_date. $reason" '{verdict: $v, reason: $r}'
            exit 0
          fi
        fi
        ;;
    esac
  fi
fi

# 4. Rejection cooldown: any closure in drip queue within 7 days
queue="$sweep/drip-queue/${owner_repo}.jsonl"
if [ -f "$queue" ]; then
  cutoff=$((now - 7 * 86400))
  recent_closure=$(tail -r "$queue" | while IFS= read -r line; do
    status=$(echo "$line" | jq -r '.status // empty')
    ts=$(echo "$line" | jq -r '.ts // empty')
    [ -z "$ts" ] && continue
    entry_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null || echo 0)
    if [ "$entry_epoch" -lt "$cutoff" ]; then
      break
    fi
    if [ "$status" = "closed" ] || [ "$status" = "rejected" ]; then
      echo "$ts"
      break
    fi
  done)
  if [ -n "$recent_closure" ]; then
    jq -n --arg v "cooldown" --arg r "PR closed on $recent_closure. 7-day cooldown." '{verdict: $v, reason: $r}'
    exit 0
  fi
fi

# 5. Clear
jq -n '{verdict: "clear", reason: ""}'
