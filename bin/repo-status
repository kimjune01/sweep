#!/usr/bin/env bash
set -euo pipefail

# Usage: repo-status <owner/repo>
# Rolls up per-repo state from existing files and emits a verdict.
#
# Inputs (read-only):
#   ~/.sweep/banlist.txt              — global ban (one repo per line, # comments ok)
#   ~/.sweep/repos.jsonl              — append-only event log; eviction = "action":"evict"
#   ~/.sweep/cooldown/<owner>-<repo>.{txt,json,ts}  — date string (YYYY-MM-DD), in the future = active
#   ~/.sweep/DENYLIST*.txt + per-repo *-denylist.txt — text grep for the repo
#
# Output: JSON {repo, verdict, blocker, sources}
#   verdict ∈ {clear, banned, evicted, cooldown, denylisted}
#
# This script is the single source of truth for "can I touch this repo right now?"
# /ship calls it as a hard block. Modeled on org-gate.

repo="${1:?Usage: repo-status <owner/repo>}"
[[ "$repo" == */* ]] || { echo "ERROR: repo must be owner/name (got: $repo)" >&2; exit 2; }

owner_repo="${repo/\//-}"
sweep="$HOME/.sweep"
verdict="clear"
blocker=""
sources='[]'

emit() {
  jq -n \
    --arg repo "$repo" \
    --arg verdict "$verdict" \
    --arg blocker "$blocker" \
    --argjson sources "$sources" \
    '{repo: $repo, verdict: $verdict, blocker: $blocker, sources: $sources}'
  exit 0
}

# 1. Global banlist
if [ -f "$sweep/banlist.txt" ]; then
  if grep -v '^[[:space:]]*#' "$sweep/banlist.txt" | grep -Fxq "$repo"; then
    verdict="banned"
    blocker="in $sweep/banlist.txt"
    sources=$(echo "$sources" | jq '. + ["banlist.txt"]')
    emit
  fi
fi

# 2. Eviction in repos.jsonl (last event for this repo)
if [ -f "$sweep/repos.jsonl" ]; then
  last_action=$(jq -rc --arg r "$repo" 'select(.repo == $r) | {action, status, reason}' "$sweep/repos.jsonl" 2>/dev/null | tail -1 || true)
  if [ -n "$last_action" ]; then
    action=$(echo "$last_action" | jq -r '.action // empty')
    status=$(echo "$last_action" | jq -r '.status // empty')
    reason=$(echo "$last_action" | jq -r '.reason // empty')
    if [ "$action" = "evict" ] || [ "$status" = "evicted" ]; then
      verdict="evicted"
      blocker="${reason:-evicted in repos.jsonl}"
      sources=$(echo "$sources" | jq '. + ["repos.jsonl"]')
      emit
    fi
  fi
fi

# 3. Cooldown (any of the three accidental extensions)
for ext in txt json ts; do
  cf="$sweep/cooldown/${owner_repo}.${ext}"
  [ -f "$cf" ] || continue
  # File contains a date string YYYY-MM-DD. JSON files may have wrapping.
  date_str=$(grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' "$cf" | head -1 || true)
  [ -z "$date_str" ] && continue
  cooldown_epoch=$(date -j -f "%Y-%m-%d" "$date_str" +%s 2>/dev/null || echo 0)
  now=$(date +%s)
  if [ "$cooldown_epoch" -gt "$now" ]; then
    verdict="cooldown"
    blocker="active until $date_str (per ${cf##*/})"
    sources=$(echo "$sources" | jq --arg s "cooldown/${owner_repo}.${ext}" '. + [$s]')
    emit
  fi
done

# 4. Denylist files (global + per-repo). Match the repo string anywhere.
for dl in "$sweep"/DENYLIST*.txt "$sweep"/*-denylist.txt; do
  [ -f "$dl" ] || continue
  if grep -Fq "$repo" "$dl" 2>/dev/null; then
    verdict="denylisted"
    blocker="listed in ${dl##*/}"
    sources=$(echo "$sources" | jq --arg s "${dl##*/}" '. + [$s]')
    emit
  fi
done

emit
