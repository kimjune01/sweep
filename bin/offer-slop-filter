#!/usr/bin/env bash
# Offer the slop filter action to a repo with an anti-AI policy.
# Idempotent: checks for existing issue before opening.
# Gathers repo-specific AI slop evidence, outputs context for LLM personalization.
#
# Usage:
#   offer-slop-filter [--dry-run] <owner/repo>          # offer mode
#   offer-slop-filter --withdraw-stale [--dry-run]      # sweep mode:
#       withdraw all our silent issues older than 2 days. Polite cleanup
#       to clear maintainer noise debt from issues that got the silent
#       treatment. Prevents the silent-treatment-as-negative bucket from
#       lingering.
set -euo pipefail

# Default is DRY (queue to inbox). --live posts to GitHub.
# Global flag ~/.sweep/control/dry forces dry regardless of --live.
LIVE=false
DRY_RUN=true
WITHDRAW_AGE_DAYS=2
INBOX="$HOME/.sweep/inbox/slop_offers_pending.jsonl"
WITHDRAW_INBOX="$HOME/.sweep/inbox/slop_withdrawals_pending.jsonl"

# Parse flags
while [ "${1:-}" != "" ]; do
  case "$1" in
    --live) LIVE=true; DRY_RUN=false; shift ;;
    --dry-run) LIVE=false; DRY_RUN=true; shift ;;
    --withdraw-stale)
      shift
      # Parse remaining flags for withdraw mode
      while [ "${1:-}" != "" ]; do
        case "$1" in
          --live) LIVE=true; DRY_RUN=false; shift ;;
          --dry-run) LIVE=false; DRY_RUN=true; shift ;;
          --age) WITHDRAW_AGE_DAYS="$2"; shift 2 ;;
          *) echo "Unknown flag: $1"; exit 2 ;;
        esac
      done
      # Belt-and-suspenders: global control/dry forces dry regardless of --live.
      if [ -f "$HOME/.sweep/control/dry" ]; then
        LIVE=false; DRY_RUN=true
      fi
      # Withdrawal mode — scan all our open issues and close silent ones
      WITHDRAW_COMMENT="Closing this. Looks like the offer didn't catch interest. No action needed; just clearing your queue. If the AI-PR pressure changes and this becomes useful, feel free to reopen.

Withdrawn after ${WITHDRAW_AGE_DAYS}d of silent treatment by [kimjune01/sweep](https://github.com/kimjune01/sweep)."

      CUTOFF_TS=$(date -u -v-${WITHDRAW_AGE_DAYS}d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || date -u -d "${WITHDRAW_AGE_DAYS} days ago" +%Y-%m-%dT%H:%M:%SZ)

      echo "Withdrawing silent issues by kimjune01 created before $CUTOFF_TS..."

      # Find our open issues with 0 comments older than cutoff.
      # gh search only exposes commentsCount; reactions require a per-issue
      # gh api call. We do that per candidate to protect 👀 / 👍 reacted issues.
      SEARCH_OUT=$(gh search issues --author kimjune01 --include-prs=false --state open \
        --created "<$CUTOFF_TS" --json url,number,repository,commentsCount \
        --limit 100 2>/dev/null || echo "[]")
      echo "$SEARCH_OUT" | python3 -c '
import json, sys, subprocess
data = json.load(sys.stdin)
for i in data:
    if i.get("commentsCount", 0) > 0: continue
    repo = i["repository"]["nameWithOwner"]
    num = i["number"]
    # Per-issue reaction check — cheap enough at this volume.
    try:
        r = subprocess.run(
            ["gh", "api", f"repos/{repo}/issues/{num}", "--jq", ".reactions.total_count"],
            capture_output=True, text=True, timeout=10)
        total = int(r.stdout.strip() or 0)
    except Exception:
        total = 0
    if total > 0: continue
    print("{}\t{}\t{}".format(repo, num, i["url"]))
' | while IFS=$'\t' read -r repo num url; do
        [ -z "$repo" ] && continue
        if [ "$DRY_RUN" = true ]; then
          # Queue withdrawal candidate for human review instead of acting.
          TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          mkdir -p "$(dirname "$WITHDRAW_INBOX")"
          BODY_JSON=$(printf '%s' "$WITHDRAW_COMMENT" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')
          printf '{"ts":"%s","repo":"%s","issue":%s,"url":"%s","reason":"silent %sd","body":%s}\n' \
            "$TS" "$repo" "$num" "$url" "$WITHDRAW_AGE_DAYS" "$BODY_JSON" >> "$WITHDRAW_INBOX"
          echo "  QUEUED: $repo#$num  $url"
        else
          if gh issue comment "$num" --repo "$repo" --body "$WITHDRAW_COMMENT" >/dev/null 2>&1 \
             && gh issue close "$num" --repo "$repo" --reason "not planned" >/dev/null 2>&1; then
            echo "  WITHDREW: $repo#$num  $url"
            TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
            mkdir -p "$HOME/.sweep/actionable"
            echo "{\"ts\":\"$TS\",\"repo\":\"$repo\",\"issue\":$num,\"action\":\"slop_filter_withdrawn\",\"url\":\"$url\",\"reason\":\"silent ${WITHDRAW_AGE_DAYS}d\"}" \
              >> "$HOME/.sweep/actionable/candidates.jsonl"
          else
            echo "  FAIL: $repo#$num"
          fi
        fi
      done
      exit 0
      ;;
    --) shift; break ;;
    -*) echo "Unknown flag: $1"; exit 2 ;;
    *) break ;;
  esac
done

REPO="${1:?Usage: offer-slop-filter [--dry-run] <owner/repo>  OR  offer-slop-filter --withdraw-stale [--dry-run] [--age N]}"
TEMPLATE="$HOME/.sweep/templates/slop-filter-issue.md"
BANLIST="$HOME/.sweep/banlist.txt"
CANDIDATES="$HOME/.sweep/actionable/candidates.jsonl"

# Skip banned repos
if [ -f "$BANLIST" ] && grep -qxF "$REPO" "$BANLIST"; then
  echo "SKIP: $REPO is banned"
  exit 0
fi

# Per-org lifetime cap. Hard limit on how many slop-filter offers we
# will ever queue or send to a single org. The principle: don't
# contribute to the problem we are helping solve. If a maintainer has
# multiple repos and our first offer landed well, lift the cap manually
# by editing this number or pruning the candidates/inbox files.
ORG=$(echo "$REPO" | cut -d'/' -f1)
PER_ORG_LIFETIME_CAP=1
# grep exits 1 on zero matches; under `set -euo pipefail` that propagates
# through the pipe and aborts the script. The `|| true` absorbs the
# grep exit, and wc gives the count regardless.
QUEUED_COUNT=$( { grep "\"repo\": *\"$ORG/" "$INBOX" 2>/dev/null || true; } | wc -l | tr -d ' ')
SENT_COUNT=$( { grep "\"action\": *\"slop_filter_offered\".*\"repo\": *\"$ORG/" "$CANDIDATES" 2>/dev/null || true; } | wc -l | tr -d ' ')
ORG_TOTAL=$(( ${QUEUED_COUNT:-0} + ${SENT_COUNT:-0} ))
if [ "$ORG_TOTAL" -ge "$PER_ORG_LIFETIME_CAP" ]; then
  echo "SKIP: $REPO  org $ORG at cap ($ORG_TOTAL queued/sent, cap=$PER_ORG_LIFETIME_CAP). Don't be the noise."
  exit 0
fi

# Pull repo metadata once: issues-enabled + primary language. The
# language drives vocabulary-matching in the rendered body (a Go
# maintainer sees `gofmt` instead of `eslint`).
REPO_META=$(gh repo view "$REPO" --json hasIssuesEnabled,primaryLanguage 2>/dev/null || echo "{}")
HAS_ISSUES=$(printf '%s' "$REPO_META" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("true" if d.get("hasIssuesEnabled") else "false")')
PRIMARY_LANG=$(printf '%s' "$REPO_META" | python3 -c 'import json,sys; d=json.load(sys.stdin).get("primaryLanguage") or {}; print(d.get("name",""))')

if [ "$HAS_ISSUES" != "true" ]; then
  echo "SKIP: $REPO has issues disabled"
  exit 0
fi

# Map primary language to the canonical linter the maintainer
# almost certainly runs. Falls back to "lint-clean" for languages we
# haven't mapped or can't detect.
case "$PRIMARY_LANG" in
  JavaScript|TypeScript)  LANG_LINTER='`eslint`' ;;
  Python)                 LANG_LINTER='`ruff`' ;;
  Go)                     LANG_LINTER='`gofmt`' ;;
  Rust)                   LANG_LINTER='`clippy`' ;;
  C++|C)                  LANG_LINTER='`clang-tidy`' ;;
  Java)                   LANG_LINTER='`checkstyle`' ;;
  Kotlin)                 LANG_LINTER='`ktlint`' ;;
  Swift)                  LANG_LINTER='`swiftlint`' ;;
  Ruby)                   LANG_LINTER='`rubocop`' ;;
  PHP)                    LANG_LINTER='`phpstan`' ;;
  C#)                     LANG_LINTER='Roslyn analyzers' ;;
  Shell)                  LANG_LINTER='`shellcheck`' ;;
  Haskell)                LANG_LINTER='`hlint`' ;;
  Elixir)                 LANG_LINTER='`credo`' ;;
  Scala)                  LANG_LINTER='`scalafix`' ;;
  Dart)                   LANG_LINTER='`dart analyze`' ;;
  Lua)                    LANG_LINTER='`luacheck`' ;;
  HCL)                    LANG_LINTER='`tflint`' ;;
  *)                      LANG_LINTER='lint' ;;
esac

# Check which filters they already have (raw curl, no API quota)
OWNER=$(echo "$REPO" | cut -d'/' -f1)
RNAME=$(echo "$REPO" | cut -d'/' -f2)
WORKFLOWS=$(curl -sL "https://github.com/$REPO/tree/HEAD/.github/workflows" 2>/dev/null || echo "")
HAS_OURS=0; HAS_ANTISLOP=0; HAS_AGENTSCAN=0; HAS_STALE_BOT=0
if echo "$WORKFLOWS" | grep -qi "kimjune01/sweep"; then HAS_OURS=1; fi
if echo "$WORKFLOWS" | grep -qi "anti-slop\|peakoss"; then HAS_ANTISLOP=1; fi
if echo "$WORKFLOWS" | grep -qi "agentscan"; then HAS_AGENTSCAN=1; fi
# Stale-bot family: any automation that auto-closes low-engagement issues/PRs.
# Two signals: (a) action references in workflow yaml content, (b) workflow
# filenames that name the function. ant-design ships custom issue-check-inactive
# and issue-close-require workflows — no third-party action, but the intent is
# the same. Cast a wide net: if a repo automates inactivity handling, our
# slop-filter offer is redundant.
if echo "$WORKFLOWS" | grep -qiE "actions/stale|probot/stale|stale-bot|lock-threads|close-stale|stale-action|issue-check-inactiv|issue-inactivit|issue-close-require|no-response|needs-info|close-issue|cron-stale"; then HAS_STALE_BOT=1; fi

# Already-protected check 1: workflow file lists a stale-bot family action.
if [ "$HAS_STALE_BOT" -gt 0 ] && [ "$HAS_OURS" -eq 0 ] && [ "$HAS_ANTISLOP" -eq 0 ] && [ "$HAS_AGENTSCAN" -eq 0 ]; then
  echo "SKIP: $REPO already uses stale-bot (already protected from low-engagement spam)"
  exit 0
fi

# Already-protected check 2: any prior issue from us in this org was bot-closed.
# This catches repos using non-stale-bot automation (DrahtBot on bitcoin,
# github-actions[bot] on ant-design, project-board automation on
# cypress/wayvnc/sourcebot, label-bots on yt-dlp/nuxt). The scoreboard cache
# is authoritative — if the org closed any prior issue from us via a bot, the
# org has automated handling and our offer is redundant.
ORG=$(echo "$REPO" | cut -d'/' -f1)
SCOREBOARD_CACHE="$HOME/.sweep/cache/scoreboard-issues.json"
if [ -f "$SCOREBOARD_CACHE" ]; then
  ORG_BOT_CLOSED=$(python3 -c "
import json, sys
issues = json.load(open('$SCOREBOARD_CACHE'))
def is_bot(l):
    if not l: return False
    l = l.lower()
    return l.endswith('bot') or l.endswith('-bot') or '[bot]' in l
hits = []
for i in issues:
    if not i.get('repo','').startswith('$ORG/'): continue
    if i.get('state') != 'closed': continue
    labels = [l.lower() for l in i.get('labels', [])]
    bot = (is_bot(i.get('closer')) or 'spam' in labels or
           (i.get('state_reason') == 'not_planned' and i.get('comments', 0) == 0))
    if bot:
        hits.append(f\"{i['repo']}#{i['number']}\")
print(','.join(hits[:3]))
" 2>/dev/null || true)
  if [ -n "$ORG_BOT_CLOSED" ]; then
    echo "SKIP: $REPO — org $ORG previously bot-closed our issue(s): $ORG_BOT_CLOSED"
    exit 0
  fi
fi

# Track which to recommend (exclude what they have)
INSTALLED=""
[ "$HAS_OURS" -gt 0 ] && INSTALLED="${INSTALLED}ours,"
[ "$HAS_ANTISLOP" -gt 0 ] && INSTALLED="${INSTALLED}antislop,"
[ "$HAS_AGENTSCAN" -gt 0 ] && INSTALLED="${INSTALLED}agentscan,"
[ "$HAS_STALE_BOT" -gt 0 ] && INSTALLED="${INSTALLED}stale-bot,"

# If they have all three slop filters, nothing to offer
if [ "$HAS_OURS" -gt 0 ] && [ "$HAS_ANTISLOP" -gt 0 ] && [ "$HAS_AGENTSCAN" -gt 0 ]; then
  echo "SKIP: $REPO already has all three filters"
  exit 0
fi

export INSTALLED

# Check for existing issue by kimjune01.
# Cover the new title ("Filter PRs by effort..."), the previous title
# ("Protect this repo from AI-generated PRs"), and the dynamic-per-repo
# variant ("Protect <name> from AI slop PRs"). Any open match dedupes.
EXISTING=""
for Q in "Filter PRs by effort" "Protect this repo from AI-generated PRs" "from AI slop PRs"; do
  HIT=$(gh search issues --author kimjune01 --repo "$REPO" "$Q" --state open --json number --jq '.[0].number // empty' 2>/dev/null || true)
  if [ -n "$HIT" ]; then EXISTING="$HIT"; break; fi
done

if [ -n "$EXISTING" ]; then
  echo "SKIP: issue #$EXISTING already open on $REPO"
  exit 0
fi

# Extract title and body from template frontmatter.
TITLE=$(awk '/^title:/{sub(/^title: *"?/,""); sub(/"?$/,""); print; exit}' "$TEMPLATE")
# Skip the YAML frontmatter (first two `---` lines) but preserve any
# `---` horizontal rules in the body proper.
BASE_BODY=$(awk 'BEGIN{n=0} /^---$/{if(n<2){n++;next}} n>=2{print}' "$TEMPLATE")
REPO_NAME=$(echo "$REPO" | cut -d'/' -f2)

# --- Gather repo-specific AI slop evidence ---

SINCE=$(date -u -v-14d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '14 days ago' +%Y-%m-%dT%H:%M:%SZ)

# Total PR volume in the last 2 weeks (for % calculation)
TOTAL_PRS=$(gh api graphql -f query="{ search(query: \"is:pr repo:$REPO created:>$SINCE\", type: ISSUE, first: 1) { issueCount } }" --jq '.data.search.issueCount' 2>/dev/null || echo "0")

# PRs closed in the last 2 weeks that look like AI slop (unmerged, by non-members)
SLOP_CANDIDATES=$(gh api graphql -f query="{ search(query: \"is:pr is:closed is:unmerged repo:$REPO created:>$SINCE\", type: ISSUE, first: 10) { issueCount nodes { ... on PullRequest { number title author { login } closedAt body } } } }" --jq '{
  count: .data.search.issueCount,
  prs: [.data.search.nodes[] | {
    num: .number,
    title: .title,
    author: .author.login,
    has_emdash: (.title + " " + (.body // "") | test("—|––|--")),
    body_len: ((.body // "") | length),
    body_text: ((.body // "")[:500])
  }]
}' 2>/dev/null || echo '{"count":0,"prs":[]}')

# How many would the filter have caught (all 6 checks)
WOULD_CATCH=$(echo "$SLOP_CANDIDATES" | python3 -c "
import json, sys, subprocess, re

data = json.load(sys.stdin)
caught = []
for p in data.get('prs', []):
    warnings = 0
    title = p.get('title', '')
    body_text = p.get('body_text', '')
    author = p.get('author', '')
    body_len = p.get('body_len', 0)

    # 1. Em dashes / double hyphens
    if p.get('has_emdash'):
        warnings += 1

    # 2. Description depth (<50 chars or WHAT not WHY)
    if body_len < 50:
        warnings += 1
    elif not re.search(r'because|root cause|the problem|the issue|the bug|rationale|the reason', body_text, re.I):
        if re.search(r'this (PR|pull request|change|commit) (adds|removes|updates|fixes|changes|modifies|implements)', body_text, re.I):
            warnings += 1

    # 3. Test presence (can't check files from here, skip)

    # 4. Contributor velocity (check author's recent PR count)
    try:
        r = subprocess.run(['gh', 'api', 'graphql', '-f',
            'query={ search(query: \"is:pr author:' + author + ' created:>2026-05-11\", type: ISSUE, first: 1) { issueCount } }'],
            capture_output=True, text=True, timeout=10)
        count = json.loads(r.stdout).get('data',{}).get('search',{}).get('issueCount',0)
        if count > 5:
            warnings += 1
    except:
        pass

    # 5. Three-strike (can't check cross-repo history cheaply, skip)

    if warnings > 0:
        caught.append(p)

print(json.dumps({
    'total_closed': data['count'],
    'would_catch': len(caught),
    'examples': [f\"#{p['num']} {p['title'][:60]}\" for p in caught[:3]]
}))" 2>/dev/null || echo '{"total_closed":0,"would_catch":0,"examples":[]}')

# Compute evidence first (no early skip).
CATCH_COUNT=$(echo "$WOULD_CATCH" | python3 -c "import json,sys; print(json.load(sys.stdin).get('would_catch',0))" 2>/dev/null || echo "0")
CATCH_PCT=0
if [ "$TOTAL_PRS" -gt 0 ]; then
  CATCH_PCT=$((CATCH_COUNT * 100 / TOTAL_PRS))
fi
HAS_EVIDENCE=false
if [ "$CATCH_COUNT" -ge 5 ] && [ "$CATCH_PCT" -ge 5 ]; then
  HAS_EVIDENCE=true
fi

# Maintainer-pain probe: someone with OWNER/MEMBER/COLLABORATOR
# authorAssociation voiced the problem in the last 60 days.
PAIN_TS=$(date -u -v-60d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '60 days ago' +%Y-%m-%dT%H:%M:%SZ)
PAIN_QUERY='"AI slop" OR "AI-generated PR" OR "LLM-generated" OR "low-quality AI" OR "AI spam" OR "ChatGPT PR" OR "Claude PR" OR "Copilot PR"'
PAIN_HITS=$(gh api graphql -f query="{ search(query: \"repo:$REPO ($PAIN_QUERY) created:>$PAIN_TS\", type: ISSUE, first: 20) { nodes { ... on Issue { number title authorAssociation author { login } } ... on PullRequest { number title authorAssociation author { login } } } } }" \
  --jq '[.data.search.nodes[] | select(.authorAssociation == "OWNER" or .authorAssociation == "MEMBER" or .authorAssociation == "COLLABORATOR") | "#\(.number) by @\(.author.login) (\(.authorAssociation))"]' 2>/dev/null || echo "[]")
PAIN_COUNT=$(echo "$PAIN_HITS" | python3 -c "import json,sys; print(len(json.load(sys.stdin)))" 2>/dev/null || echo "0")
HAS_PAIN=false
if [ "$PAIN_COUNT" -ge 1 ]; then
  HAS_PAIN=true
fi

# Written-policy probe: does CONTRIBUTING.md / AGENTS.md already express
# pain about AI PRs but no filter is installed? That's the strongest
# opportunity signal — the maintainer has codified the policy but hasn't
# installed enforcement. We are the implementation of their stated wish.
NO_FILTER_INSTALLED=true
[ "$HAS_OURS" -gt 0 ] && NO_FILTER_INSTALLED=false
[ "$HAS_ANTISLOP" -gt 0 ] && NO_FILTER_INSTALLED=false
[ "$HAS_AGENTSCAN" -gt 0 ] && NO_FILTER_INSTALLED=false
[ "$HAS_STALE_BOT" -gt 0 ] && NO_FILTER_INSTALLED=false

HAS_POLICY=false
POLICY_QUOTE=""
POLICY_FILE=""
if [ "$NO_FILTER_INSTALLED" = true ]; then
  for P in CONTRIBUTING.md AGENTS.md docs/CONTRIBUTING.md .github/CONTRIBUTING.md; do
    DOC=$(curl -fsSL "https://raw.githubusercontent.com/$REPO/HEAD/$P" 2>/dev/null || true)
    [ -z "$DOC" ] && continue
    LINE=$( { printf '%s' "$DOC" | grep -iE 'no AI|do not (use|submit).*(AI|LLM|GPT|Claude|Copilot)|AI[- ]generated|LLM[- ]generated|AI[- ]assisted PR|AI[- ]slop' || true; } | head -1 | cut -c1-140)
    if [ -n "$LINE" ]; then
      HAS_POLICY=true
      POLICY_QUOTE="$LINE"
      POLICY_FILE="$P"
      break
    fi
  done
fi

# OR gate: evidence OR voiced pain OR written policy. All three absent
# means we'd be projecting; skip.
if [ "$HAS_EVIDENCE" != true ] && [ "$HAS_PAIN" != true ] && [ "$HAS_POLICY" != true ]; then
  echo "SKIP: $REPO — no evidence (${CATCH_COUNT}/${TOTAL_PRS}), no pain mention in 60d, no written policy"
  exit 0
fi

PAIN_EXAMPLE=$(echo "$PAIN_HITS" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0] if d else '')" 2>/dev/null || echo "")

# Compose the lead paragraph from whichever signals fired. Three
# possible openers (policy / pain / evidence), composable. Python
# handles the prose so the bash glue stays simple.
EVIDENCE_LIST=$(echo "$WOULD_CATCH" | python3 -c "
import json, sys
d = json.loads(sys.stdin.read())
for ex in d.get('examples', [])[:6]:
    print(f'- {ex}')
" 2>/dev/null || echo "")
if [ -z "$EVIDENCE_LIST" ]; then
  EVIDENCE_LIST=$(echo "$SLOP_CANDIDATES" | python3 -c "
import json, sys
d = json.load(sys.stdin)
for p in d.get('prs', [])[:6]:
    print(f\"- #{p['num']} {p['title'][:70]}\")
" 2>/dev/null || echo "")
fi

LEAD=$(REPO="$REPO" HAS_EVIDENCE="$HAS_EVIDENCE" HAS_PAIN="$HAS_PAIN" \
       HAS_POLICY="$HAS_POLICY" POLICY_FILE="$POLICY_FILE" \
       POLICY_QUOTE="$POLICY_QUOTE" PAIN_EXAMPLE="$PAIN_EXAMPLE" \
       EVIDENCE_COUNT="$CATCH_COUNT" EVIDENCE_LIST="$EVIDENCE_LIST" \
       python3 -c '
import os
parts = []
if os.environ["HAS_POLICY"] == "true":
    f = os.environ["POLICY_FILE"]
    q = os.environ["POLICY_QUOTE"].strip()
    parts.append(f"Your `{f}` already names the problem: \"{q}\". Nothing in CI is enforcing it yet.")
elif os.environ["HAS_PAIN"] == "true":
    pe = os.environ["PAIN_EXAMPLE"]
    parts.append(f"Saw {pe} mention AI-slop pressure.")

count = int(os.environ["EVIDENCE_COUNT"] or 0)
lst = os.environ["EVIDENCE_LIST"].strip()
if os.environ["HAS_EVIDENCE"] == "true":
    parts.append(f"Over the last 14 days, **{count} PRs** to this repo would have been flagged by a PR linter for low-effort submissions:\n\n{lst}")
elif count > 0 and lst:
    parts.append(f"A few in the last 14 days:\n\n{lst}")
print("\n\n".join(parts))
')

BODY=$(BASE_BODY="$BASE_BODY" LEAD="$LEAD" LANG_LINTER="$LANG_LINTER" python3 -c '
import os
body = os.environ["BASE_BODY"]
body = body.replace("{{lead}}", os.environ["LEAD"])
body = body.replace("{{lang_linter}}", os.environ["LANG_LINTER"])
print(body)
')

# Quality gate on our own outbound. Symmetric with what we offer
# maintainers — same class of cheap deterministic checks, applied to
# our own output. Refuses to queue or post if the body has em-dashes
# in prose, unrendered slots, a too-long title, etc. The check is the
# product; if our outbound fails it, we don't ship.
if ! printf '%s' "$BODY" | ~/.sweep/bin/gate-outbound --title "$TITLE" >&2; then
  echo "ABORT: $REPO failed outbound quality gate. See above; refusing to ship."
  exit 2
fi

if [ "$LIVE" != true ]; then
  # Default mode: queue candidate to inbox for human review. Two clamps —
  # missing --live AND/OR ~/.sweep/control/dry both route here.
  TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  mkdir -p "$(dirname "$INBOX")"
  TS="$TS" REPO="$REPO" TITLE="$TITLE" \
    CATCH_COUNT="$CATCH_COUNT" TOTAL_PRS="$TOTAL_PRS" CATCH_PCT="$CATCH_PCT" \
    PAIN_EXAMPLE="$PAIN_EXAMPLE" BODY="$BODY" \
    python3 -c '
import json, os
row = {
  "ts": os.environ["TS"],
  "repo": os.environ["REPO"],
  "title": os.environ["TITLE"],
  "evidence_count": int(os.environ["CATCH_COUNT"]),
  "total_prs": int(os.environ["TOTAL_PRS"]),
  "catch_pct": int(os.environ["CATCH_PCT"]),
  "pain_example": os.environ.get("PAIN_EXAMPLE", ""),
  "body": os.environ["BODY"],
}
print(json.dumps(row))
' >> "$INBOX"
  echo "QUEUED: $REPO (${CATCH_COUNT}/${TOTAL_PRS} = ${CATCH_PCT}%) → $INBOX"
  exit 0
fi

# --live: open the issue
RESULT=$(gh issue create --repo "$REPO" \
  --title "$TITLE" \
  --body "$BODY" 2>&1) || {
  echo "FAIL: $RESULT"
  exit 1
}

echo "OPENED: $RESULT"

# Log
